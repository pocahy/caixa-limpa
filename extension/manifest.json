{
  "manifest_version": 3,
  "name": "Caixa Limpa",
  "version": "1.1.0",
  "description": "Pomodoro, captura rápida e o seu dia do Caixa Limpa (GTD) direto no navegador.",
  "key": "",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Caixa Limpa",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "identity",
    "contextMenus",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://firestore.googleapis.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*",
    "https://pocahy.github.io/*",
    "https://www.googleapis.com/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://pocahy.github.io/caixa-limpa/*"
      ],
      "js": [
        "cs.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "omnibox": {
    "keyword": "cl"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Abrir o Caixa Limpa"
    },
    "toggle-pomodoro": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Iniciar, pausar ou continuar o Pomodoro"
    }
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.js",
        "ui.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}